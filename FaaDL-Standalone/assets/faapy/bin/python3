#!/system/bin/sh
# Faa Magisk Python - python3 (interpreter)
# Interpreter asli di-mount ke /system/bin/python3.14, lib & stdlib di /system/lib64.
# lib-dynload (C-extension .so) harus ada di LD_LIBRARY_PATH agar bisa di-dlopen
# oleh user non-root (selain /system/lib64 untuk libpython3.14.so).

export PYTHONHOME=/system/lib64
export LD_LIBRARY_PATH=/system/lib64/lib/python3.14/lib-dynload:/system/lib64:$LD_LIBRARY_PATH
export PIP_ROOT_USER_ACTION=ignore

exec /system/bin/python3.14 "$@"
